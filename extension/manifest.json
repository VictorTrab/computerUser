{
  "manifest_version": 3,
  "name": "Skynet Bridge",
  "version": "1.0.9",
  "description": "Puente local de control de navegador para agentes de IA.",
  "action": {
    "default_icon": {
      "16": "images/icon16.png",
      "32": "images/icon32.png",
      "48": "images/icon48.png"
    },
    "default_title": "ComputerUser Browser Bridge"
  },
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "images/icon16.png",
    "32": "images/icon32.png",
    "48": "images/icon48.png",
    "128": "images/icon128.png"
  },
  "permissions": [
    "alarms",
    "bookmarks",
    "debugger",
    "declarativeNetRequestWithHostAccess",
    "downloads",
    "favicon",
    "history",
    "nativeMessaging",
    "notifications",
    "scripting",
    "sessions",
    "storage",
    "tabGroups",
    "tabs",
    "topSites",
    "webNavigation",
    "contextMenus",
    "sidePanel"
  ],
  "optional_permissions": [
    "downloads.open"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; connect-src 'self' http://127.0.0.1:* http://localhost:* ws://127.0.0.1:* ws://localhost:*;",
    "sandbox": "sandbox allow-scripts; default-src 'none'; script-src 'self' 'unsafe-eval'; worker-src blob:; connect-src 'none';"
  },
  "web_accessible_resources": [
    {
      "matches": [
        "<all_urls>"
      ],
      "resources": [
        "images/cursor-chat.png"
      ]
    }
  ],
  "key": "",
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Ctrl+Shift+Period",
        "mac": "Command+Shift+Period"
      }
    },
    "open-codex-side-panel": {
      "description": "Open ChatGPT side panel"
    }
  },
  "content_scripts": [
    {
      "all_frames": false,
      "js": [
        "content-scripts/chatgpt-website.js"
      ],
      "matches": [
        "https://chatgpt.com/*"
      ],
      "run_at": "document_end"
    },
    {
      "all_frames": true,
      "js": [
        "content-scripts/codex-work-media-permission.js"
      ],
      "matches": [
        "https://chatgpt.com/*"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    }
  ],
  "minimum_chrome_version": "116",
  "side_panel": {
    "default_path": "codex-sidepanel/index.html"
  }
}